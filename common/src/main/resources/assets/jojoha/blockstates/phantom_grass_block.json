{
  "multipart": [
    {
      "apply": {
        "model": "jojoha:block/phantom_grass_block_top"
      }
    },
    {
      "when": {
        "north": "false"
      },
      "apply": {
        "model": "jojoha:block/phantom_grass_block_side"
      }
    },
    {
      "when": {
        "north": "true"
      },
      "apply": {
        "model": "jojoha:block/phantom_grass_block_connected"
      }
    },
    {
      "when": {
        "east": "false"
      },
      "apply": {
        "model": "jojoha:block/phantom_grass_block_side",
        "y": 90
      }
    },
    {
      "when": {
        "east": "true"
      },
      "apply": {
        "model": "jojoha:block/phantom_grass_block_connected",
        "y": 90
      }
    },
    {
      "when": {
        "south": "false"
      },
      "apply": {
        "model": "jojoha:block/phantom_grass_block_side",
        "y": 180
      }
    },
    {
      "when": {
        "south": "true"
      },
      "apply": {
        "model": "jojoha:block/phantom_grass_block_connected",
        "y": 180
      }
    },
    {
      "when": {
        "west": "false"
      },
      "apply": {
        "model": "jojoha:block/phantom_grass_block_side",
        "y": 270
      }
    },
    {
      "when": {
        "west": "true"
      },
      "apply": {
        "model": "jojoha:block/phantom_grass_block_connected",
        "y": 270
      }
    }
  ]
}
